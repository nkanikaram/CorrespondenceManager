<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

	  <!-- NuGet Package Metadata -->
	  <PackageId>ECCO.CommunicationManager.Application</PackageId>
	  <Version>1.0.3</Version>
	  <Authors>ECCO Development Team</Authors>
	  <Company>S9uareRoot LLC</Company>
	  <Product>ECCO Communication Manager</Product>
	  <Description>Application layer for ECCO Communication Manager containing application services, use cases, business logic orchestration, and service interfaces. This package implements the application layer following Clean Architecture principles, coordinating between the domain and infrastructure layers.</Description>
	  <Copyright>Copyright © 2024-2026 S9uareRoot LLC. All rights reserved.</Copyright>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageProjectUrl>https://dev.azure.com/S9uareRootLLC/CorporateServices/_git/ECCO-CommunicationManager</PackageProjectUrl>
	  <RepositoryUrl>https://dev.azure.com/S9uareRootLLC/CorporateServices/_git/ECCO-CommunicationManager</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>
	  <PackageTags>ecco;communication-manager;application;clean-architecture;use-cases;services;business-logic;automapper;correspondence</PackageTags>
	  <PackageReleaseNotes>
		  Version 1.0.3 (Current Release)
		  - Application services (CorrespondenceRequestService, RoutingConfigurationService, DocumentIdsService)
		  - Service interfaces (IVentureFusionService, ICorrespondenceFilterService)
		  - AutoMapper mapping profiles for DTOs
		  - Business logic orchestration layer
		  - Integration with Domain and Infrastructure layers
	  </PackageReleaseNotes>
	  <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
	  <PackageReadmeFile>README.md</PackageReadmeFile>

	  <!-- Build Configuration -->
	  <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <NoWarn>$(NoWarn);1591</NoWarn>
	  <IncludeSymbols>true</IncludeSymbols>
	  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	  <EmbedUntrackedSources>true</EmbedUntrackedSources>
	  <Deterministic>true</Deterministic>
	  <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

	  <!-- Assembly Information -->
	  <AssemblyTitle>ECCO Communication Manager - Application Layer</AssemblyTitle>
	  <AssemblyVersion>1.0.0.0</AssemblyVersion>
	  <FileVersion>1.0.0.0</FileVersion>
	  <InformationalVersion>1.0.0</InformationalVersion>
	  <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CustomerCorrespondence.Domain\CustomerCorrespondence.Domain.csproj" />
  </ItemGroup>
	
	<ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

  <ItemGroup>
    <Folder Include="DTOs\" />
    <Folder Include="MappingProfiles\" />
  </ItemGroup>

</Project>
