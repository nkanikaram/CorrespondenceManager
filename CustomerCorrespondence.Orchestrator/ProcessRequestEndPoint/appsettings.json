  // Correspondence Manager portal sign-in (see ProcessRequestEndPoint/Auth). SigningKey must come from an
  // App Service setting / Key Vault reference (PortalAuth__SigningKey) outside Development.
  "PortalAuth": {
    "Issuer": "ecco-correspondence-portal",
    "Audience": "ecco-correspondence-portal",
    "TokenLifetimeMinutes": 60,
    "LockoutThreshold": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 12,
    "AccessProfileCacheSeconds": 60,
    // Microsoft Entra ID single sign-on. Register a single-page application (redirect URI = the portal URL), add the
    // "groups" (or app roles) claim to its ID token, then set TenantId, ClientId and Enabled=true.
    "Entra": {
      "Enabled": false,
      "TenantId": null,
      "ClientId": null,
      "RequireMfa": true,
      "AutoProvision": true
    },
    // Password sign-in. With SSO on, set Enabled=true and AllowedUserNames to one break-glass administrator, or false.
    "LocalLogin": {
      "Enabled": true,
      "AllowedUserNames": []
    },
    // "Forgot password?" by emailed one-time link (local accounts with an email address). Uses the SMTP server in
    // PasswordReset:Email if set, otherwise Alerts:Email. PortalUrl builds the link (falls back to Alerts:PortalUrl).
    // In Development with no SMTP server, the link is written to the API log instead.
    "PasswordReset": {
      "Enabled": true,
      "LinkLifetimeMinutes": 30,
      "MaxRequestsPerHour": 3,
      "MaxRequestsPerIpPerHour": 20,
      "PortalUrl": null
    },
    // Account menu help links (hidden while null) and the environment name shown next to the version.
    "Support": { "Email": null, "GuideUrl": null, "EnvironmentName": null }
  },
  // PDF of each correspondence request, stored in Blob Storage (see ProcessRequestEndPoint/Pdf). In Azure set
  // PdfGeneration__Blob__ServiceUri (managed identity needs "Storage Blob Data Contributor") and PdfGeneration__Enabled=true.
  "PdfGeneration": {
    "Enabled": false,
    "PollIntervalSeconds": 30,
    "BatchSize": 10,
    "MaxAttempts": 5,
    "MinAgeSeconds": 60,
    "BackfillDays": 1,
    "MaskPolicyNumber": true,
    "Blob": {
      "ContainerName": "correspondence-pdfs"
    }
  },
  // Recycle bin and records retention (ProcessRequestEndPoint/Records). RecordRetentionDays: null = records never expire.
  "Retention": {
    "Enabled": true,
    "RecycleBinDays": 30,
    "IntervalHours": 6,
    "RecordRetentionDays": null
  },
  // Letterhead on customer letters rendered from published templates (ProcessRequestEndPoint/Letters).
  "Letters": {
    "CompanyName": "ECCO Insurance",
    "AddressLines": [ "100 Main Street", "Springfield, IL 62701" ],
    "Phone": "1-800-555-0100",
    "Website": "www.example.com",
    "BrandColor": "#0066CC"
  },
  // Server-side alert checks (ProcessRequestEndPoint/Alerts). Put Teams:WebhookUrl and Email:Password in Key Vault /
  // App Service settings (Alerts__Teams__WebhookUrl, Alerts__Email__Password), not in this file.
  "Alerts": {
    "Enabled": true,
    "IntervalMinutes": 10,
    "CooldownHours": 6,
    "PortalUrl": null,
    "FailedRate": { "Enabled": true, "WindowHours": 24, "MinSample": 20, "Multiplier": 1.5, "MinIncrease": 0.1, "AbsoluteThreshold": 0.25 },
    "ProcessingBacklog": { "Enabled": true, "OlderThanHours": 48, "Threshold": 25 },
    "PdfFailures": { "Enabled": true, "Threshold": 1 },
    // New SLA breaches since the previous check (targets are set under Administration > SLA).
    "SlaBreaches": { "Enabled": true, "Threshold": 1, "CriticalThreshold": 25 },
    "Teams": { "WebhookUrl": null },
    "Email": { "Host": null, "Port": 587, "EnableSsl": true, "From": null, "To": [] }
  }
