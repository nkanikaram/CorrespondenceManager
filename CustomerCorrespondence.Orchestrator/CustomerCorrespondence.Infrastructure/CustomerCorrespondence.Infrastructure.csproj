<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <!-- NuGet Package Metadata -->
	  <PackageId>ECCO.CommunicationManager.Infrastructure</PackageId>
	  <Version>1.0.1-Beta</Version>
	  <Authors>ECCO Development Team</Authors>
	  <Company>S9uareRoot LLC</Company>
	  <Product>ECCO Communication Manager</Product>
	  <Description>Infrastructure layer for ECCO Communication Manager containing data access, external service integrations, messaging, health checks, and infrastructure implementations. Includes EF Core repositories, Azure integrations (Key Vault, Service Bus, SQL), PGP encryption, VentureFusion API client, NServiceBus routing, and comprehensive health monitoring.</Description>
	  <Copyright>Copyright © 2024-2026 S9uareRoot LLC. All rights reserved.</Copyright>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageProjectUrl>https://dev.azure.com/S9uareRootLLC/CorporateServices/_git/ECCO-CommunicationManager</PackageProjectUrl>
	  <RepositoryUrl>https://dev.azure.com/S9uareRootLLC/CorporateServices/_git/ECCO-CommunicationManager</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>
	  <PackageTags>ecco;communication-manager;infrastructure;ef-core;azure;repositories;key-vault;service-bus;pgp-encryption;health-checks;nservicebus;venture-fusion</PackageTags>
	  <PackageReleaseNotes>
		  Version 1.0.1-Beta (Initial Release)
		  - EF Core 9.0 repositories with SQL Server and Managed Identity authentication
		  - CorrespondenceDBContext with fluent API entity configurations
		  - Repository implementations (CorrespondenceRequest, RoutingConfiguration, DocumentIds, StatusHistory)
		  - Azure Key Vault integration with in-memory caching (SecretsCacheService)
		  - PGP encryption service using BouncyCastle for sensitive data
		  - VentureFusion API client with OAuth 2.0 bearer token authentication
		  - NServiceBus routing slip forwarder for sequential message processing
		  - Health checks for Azure SQL, Key Vault, and Service Bus
		  - Document ID generator service with atomic assignment
		  - Correspondence filter service with encrypted policy number search
		  - Managed Identity support for all Azure services
		  - Log injection prevention and security best practices
	  </PackageReleaseNotes>
	  <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	
	  <!-- Build Configuration -->
	  <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <IncludeSymbols>true</IncludeSymbols>
	  <SymbolPackageFormat>snupkg</SymbolPackageFormat>
	  <EmbedUntrackedSources>true</EmbedUntrackedSources>
	  <Deterministic>true</Deterministic>
	  <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

	  <!-- Assembly Information -->
	  <AssemblyTitle>ECCO Communication Manager - Infrastructure Layer</AssemblyTitle>
	  <AssemblyVersion>1.0.0.0</AssemblyVersion>
	  <FileVersion>1.0.0.0</FileVersion>
	  <InformationalVersion>1.0.0</InformationalVersion>
	  <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.8.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.0" />
    <PackageReference Include="Polly" Version="8.6.6" />
  </ItemGroup>

	<ItemGroup>
		<!-- Include README.md in the package -->
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CustomerCorrespondence.Application\CustomerCorrespondence.Application.csproj" />
		<ProjectReference Include="..\CustomerCorrespondence.Domain\CustomerCorrespondence.Domain.csproj" />
		<ProjectReference Include="..\CustomerCorrespondence.Exceptions\CustomerCorrespondence.Exceptions.csproj" />
	</ItemGroup>

</Project>
